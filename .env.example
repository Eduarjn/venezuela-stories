# Copie este arquivo para .env e preencha com seus valores.
# Nunca faça commit do .env — ele está no .gitignore.

# --- Anthropic / Claude (Módulo 1: story_engine.py) ---
# Quem escreve o roteiro:
#   claude_code = o Claude Code instalado e logado neste PC (usa a sua assinatura Pro/Max,
#                 sem chave de API). Faça login uma vez rodando "claude" no terminal.
#   api         = chave da API (console.anthropic.com), cobrada à parte em créditos.
ANTHROPIC_BACKEND=claude_code
# Só para ANTHROPIC_BACKEND=api:
ANTHROPIC_API_KEY=
# Modelo. Na API: obrigatório (nome do console). No claude_code: opcional (ex.: sonnet);
# vazio = o modelo padrão do seu Claude Code. Para o roteiro diário, "sonnet" gasta menos
# do limite da assinatura que o padrão.
ANTHROPIC_MODEL=
# Opcional: caminho do Claude Code se ele não estiver no PATH (ex.: C:\Users\voce\.local\bin\claude.exe)
CLAUDE_BIN=

# --- Imagens (Módulo 2: visual_generator.py) ---
# stock  = imagens REAIS e grátis com licença de uso (Wikimedia Commons + Pexels). Padrão.
# gemini = imagens geradas por IA no Gemini (pago, ~US$0,07 por imagem).
IMAGE_PROVIDER=stock
# Chave grátis da Pexels (pexels.com/api): recomendada. Sem ela, cenas genéricas (tempestade,
# lago, pescador, floresta) costumam ficar sem imagem própria e repetem a de outra cena.
PEXELS_API_KEY=
# 1 = aceita também imagens CC BY-SA (mais opções, mas a licença pode exigir que o vídeo
# siga a mesma licença). 0 = só domínio público, CC0, CC BY e Pexels.
ALLOW_SHARE_ALIKE=0

# --- Google Gemini (só para IMAGE_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Modelo de geração de imagem. Não há padrão fixo: os modelos de imagem do Google
# são aposentados com frequência. Veja os disponíveis na sua conta com:
#   python visual_generator.py --list-models
GEMINI_IMAGE_MODEL=
# Estilo fixo de todas as imagens (opcional; vazio = padrão do código)
VISUAL_STYLE_PREFIX=

# --- Voz (Módulo 3: voice_engine.py) ---
# edge = edge-tts (grátis) | elevenlabs = ElevenLabs (pago) | openai = OpenAI TTS (pago)
# O idioma vem do episódio (story_engine.py --language).
TTS_PROVIDER=edge
EDGE_TTS_RATE=+5%
# Vozes neurais do edge-tts (liste com: edge-tts --list-voices)
EDGE_TTS_VOICE_PT=pt-BR-AntonioNeural
EDGE_TTS_VOICE_ES=es-VE-SebastianNeural
# ElevenLabs devolve timestamps por caractere
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
# OpenAI TTS (precisa de requirements-optional.txt: alinhamento com faster-whisper)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
WHISPER_MODEL_SIZE=small

# --- Edição (Módulo 4: video_editor.py) ---
# Fonte das legendas: nome instalado no sistema ou arquivo .ttf/.otf em assets/fonts/
SUBTITLE_FONT=Arial Black
# Limita os núcleos do FFmpeg no render final (vazio = automático)
FFMPEG_THREADS=

# --- Conteúdo ---
# pt-BR, es-419 ou os dois separados por vírgula
VIDEO_LANGUAGES=pt-BR,es-419
# 1080x1920 = vertical (TikTok/Reels/Shorts)
VIDEO_RESOLUTION=1080x1920

# --- Piloto automático (Módulo 5: daily_scheduler.py) ---
# Horário do vídeo diário (HH:MM, horário do seu computador)
DAILY_RUN_TIME=08:00
# Se falhar: nova tentativa a cada X minutos, no máximo N vezes por dia
RETRY_MINUTES=30
MAX_RUNS_PER_DAY=4

# --- Caminhos (relativos à raiz do projeto) ---
DATABASE_PATH=data/stories.db
OUTPUT_DIR=output
